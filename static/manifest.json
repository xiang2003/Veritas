{
  "manifest_version": 3,
  "name": "Veritas",
  "version": "0.1.0",
  "description": "Highlight hard vocabulary in English news and practice speaking about it with an AI tutor.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.dictionaryapi.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Veritas – open tutor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.cnn.com/*",
        "https://*.bbc.com/*",
        "https://*.bbc.co.uk/*",
        "https://*.nytimes.com/*",
        "https://*.theguardian.com/*",
        "https://*.reuters.com/*",
        "https://apnews.com/*",
        "https://*.washingtonpost.com/*",
        "https://*.npr.org/*",
        "https://*.cnbc.com/*",
        "https://time.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
