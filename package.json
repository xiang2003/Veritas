{
  "name": "veritas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension: highlight hard English vocabulary in news and practice speaking with a Gemini tutor.",
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.2"
  }
}
